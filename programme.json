{
  "warmups": [
    {
      "id": "warmup_upper_5min",
      "title": "Échauffement haut du corps",
      "max_duration_min": 5,
      "tags": ["upper", "base"],
      "steps": [
        {
          "id": "wrists_circles",
          "type": "reps_both_directions",
          "title": "Moulinets poignets",
          "reps_min": 10,
          "reps_max": 15,
          "unit": "par sens"
        },
        {
          "id": "elbows_circles",
          "type": "reps_both_directions",
          "title": "Moulinets coudes",
          "reps_min": 10,
          "reps_max": 15,
          "unit": "par sens"
        },
        {
          "id": "shoulders_circles",
          "type": "reps_both_directions",
          "title": "Moulinets épaules",
          "reps_min": 10,
          "reps_max": 15,
          "unit": "par sens"
        },
        {
          "id": "trunk_twists",
          "type": "reps_each_side",
          "title": "Torsions de buste",
          "reps_min": 10,
          "reps_max": 15,
          "unit": "par côté"
        },
        {
          "id": "wrist_extensions",
          "type": "reps_each_angle",
          "title": "Extensions de poignets",
          "reps": 5,
          "unit": "par angle"
        },
        {
          "id": "wrist_flexions",
          "type": "reps_each_angle",
          "title": "Flexions de poignets",
          "reps": 5,
          "unit": "par angle"
        },
        {
          "id": "pull_exercise",
          "type": "exercise_slot",
          "title": "Exercice pull",
          "reps_min": 10,
          "reps_max": 15,
          "slot": "pull"
        },
        {
          "id": "push_exercise",
          "type": "exercise_slot",
          "title": "Exercice push",
          "reps_min": 15,
          "reps_max": 20,
          "slot": "push"
        },
        {
          "id": "abs_block",
          "type": "conditional",
          "title": "Exercice abdos",
          "default": {
            "id": "plank",
            "type": "timer",
            "title": "Gainage",
            "duration_sec": 30
          },
          "rules": [
            {
              "if_tags_any": ["skill_drapeau"],
              "use": {
                "id": "side_plank",
                "type": "timer_each_side",
                "title": "Gainage côté",
                "duration_sec": 30,
                "unit": "par côté"
              }
            },
            {
              "if_tags_any": ["skill_l_sit"],
              "use": {
                "id": "leg_raises",
                "type": "reps",
                "title": "Montée de jambes",
                "reps_min": 10,
                "reps_max": 15
              }
            },
            {
              "if_tags_any": ["skill_front_lever"],
              "use": {
                "id": "hollow_boat",
                "type": "timer",
                "title": "Bateau",
                "duration_sec": 30
              }
            }
          ]
        }
      ]
    },
    {
      "id": "warmup_lower_3min",
