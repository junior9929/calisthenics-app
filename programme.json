      "fundamentals_order": ["pullups", "pushups", "pistols", "plank", "dips", "lsit"],
      "session_rules": {
        "format": "circuit",
        "rounds": 4,
        "rest_between_exercises_sec": {
          "min": 45,
          "max": 60
