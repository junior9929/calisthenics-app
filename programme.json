        "rest_between_rounds_sec": 120,
        "validation_reference": "round1_when_fresh"
      },
      "fallback_rules": {
        "reps_threshold": 3,
        "hold_threshold_sec": 5,
        "prompt_for_fallback": true,
        "description": "Si <= 3 reps (ou <= 5 sec pour un hold), proposer de compléter avec le niveau précédent."
